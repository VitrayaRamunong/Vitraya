# === 认证（三选一，见 .env 说明）===  
- TS_AUTHKEY=${TS_AUTHKEY}  
# - TS_CLIENT_ID=${TS_CLIENT_ID}  
# - TS_CLIENT_SECRET=${TS_CLIENT_SECRET}  

# === 节点基本配置 ===  
- TS_HOSTNAME=${TS_HOSTNAME}  
- TS_USERSPACE=${TS_USERSPACE:-false}  
- TS_STATE_DIR=${TS_STATE_DIR:-/var/lib/tailscale}  
- TS_AUTH_ONCE=${TS_AUTH_ONCE:-true}  
- TS_ACCEPT_DNS=${TS_ACCEPT_DNS:-false}  

# === 子网路由 ===  
- TS_ROUTES=${TS_ROUTES}  

# === 代理功能（按需启用）===  
# - TS_DEST_IP=${TS_DEST_IP}  
# - TS_TAILNET_TARGET_IP=${TS_TAILNET_TARGET_IP}  
# - TS_TAILNET_TARGET_FQDN=${TS_TAILNET_TARGET_FQDN}  
# - TS_SOCKS5_SERVER=${TS_SOCKS5_SERVER}  
# - TS_OUTBOUND_HTTP_PROXY_LISTEN=${TS_OUTBOUND_HTTP_PROXY_LISTEN}  

# === Serve 配置 ===  
- TS_SERVE_CONFIG=${TS_SERVE_CONFIG:-/config/serve-config.json}

# === 监控与健康检查 ===  
- TS_ENABLE_METRICS=${TS_ENABLE_METRICS:-true}  
- TS_ENABLE_HEALTH_CHECK=${TS_ENABLE_HEALTH_CHECK:-true}  
- TS_LOCAL_ADDR_PORT=${TS_LOCAL_ADDR_PORT:-[::]:9002}  

# === 额外参数 ===  
- TS_EXTRA_ARGS=${TS_EXTRA_ARGS}  
# - TS_TAILSCALED_EXTRA_ARGS=${TS_TAILSCALED_EXTRA_ARGS}  

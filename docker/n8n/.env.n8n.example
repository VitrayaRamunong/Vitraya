# 1. 核心安全（必须）
N8N_ENCRYPTION_KEY=
N8N_SECRET_KEY=
DB_PASSWORD=
REDIS_PASSWORD=
RUNNERS_TOKEN=

# 2. 服务器配置
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROTOCOL=http
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_LISTEN_ADDRESS=::
N8N_PATH=/
WEBHOOK_URL=${N8N_EDITOR_BASE_URL}

N8N_USER_FOLDER=/home/node
N8N_PUSH_BACKEND=websocket

# 3. 数据库（Postgres）
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n

DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_TABLE_PREFIX=n8n_

# 4. Redis连接
N8N_REDIS_HOST=n8n-redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=${REDIS_PASSWORD}

# 5. 执行配置（executions）
EXECUTIONS_MODE=queue

# 6. 队列配置（queue）
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=${REDIS_PASSWORD}
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

QUEUE_BULL_PREFIX=n8n:
QUEUE_BULL_REDIS_DB=0

# 7. 任务运行器（runners）
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=external
N8N_RUNNERS_AUTH_TOKEN=${RUNNERS_TOKEN}

N8N_RUNNERS_BROKER_PORT=5679
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_TASK_BROKER_URI=http://127.0.0.1:5679
N8N_RUNNERS_LAUNCHER_HEALTH_CHECK_PORT=5680

N8N_BLOCK_RUNNER_ENV_ACCESS=true

# 8. 节点配置（nodes）
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_PYTHON_ENABLED=true
N8N_VERIFIED_PACKAGES_ENABLED=true

N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom-nodes
N8N_COMMUNITY_PACKAGES_PREVENT_LOADING=false

# 9. 端点配置（endpoint）
N8N_METRICS=true
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
N8N_METRICS_PREFIX=n8n_

# 10. 工作流配置（workflow）
WORKFLOWS_DEFAULT_NAME=My workflow
N8N_WORKFLOW_CALLER_POLICY_DEFAULT_OPTION=workflowsFromSameOwner
N8N_WORKFLOW_TAGS_DISABLED=false

# 11. 日志配置（logging）
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_LOG_FORMAT=json
N8N_LOG_FILE_LOCATION=/home/node/.n8n/logs/n8n.log

CODE_ENABLE_STDOUT=true

# 12. 安全配置（security）
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_SECURE_COOKIE=true

N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true

# 13. 邮件&2FA&用户管理

# 14. 二进制数据（BinaryData）
N8N_DEFAULT_BINARY_DATA_MODE=database

# 15. 凭证管理（Crendentials）
CREDENTIALS_OVERWRITE_PERSISTENCE=true

N8N_HIDE_USAGE_PAGE=false

GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_DEFAULT_LOCALE=en

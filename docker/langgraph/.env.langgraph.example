# 数据库连接（注意 sslmode 根据你的配置调整）  
DATABASE_URI=postgres://user:password@postgres:5432/langgraph_db?sslmode=require  
POSTGRES_URI=postgres://user:password@postgres:5432/langgraph_db?sslmode=require  
# Redis 连接（带密码）  
REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379  
# 图定义  
LANGSERVE_GRAPHS='{"agent": "/app/graph/agent.py:graph"}'  
# 认证  
LANGSMITH_API_KEY=${LANGSMITH_API_KEY}  
LANGGRAPH_AUTH_TYPE=noop
